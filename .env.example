# Blockchain Configuration
INTUITION_RPC_URL=https://testnet.rpc.intuition.systems/http
CHAIN_ID=13579

# Database Configuration (if using PostgreSQL instead of MemStorage)
DATABASE_URL=postgresql://username:password@localhost:5432/intufarm

# Server Configuration
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=your-jwt-secret-key
SESSION_SECRET=your-session-secret-key

# Optional: Alchemy/Infura keys for additional RPC providers
ALCHEMY_API_KEY=your-alchemy-api-key
INFURA_PROJECT_ID=your-infura-project-id

# Optional: Block explorer API keys for transaction verification
ETHERSCAN_API_KEY=your-etherscan-api-key

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
